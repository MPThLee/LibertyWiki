{
  "policyVersion": "1.1",
  "apiFamilies": {
    "mediaWikiCompatible": [
      "/w/api.php",
      "/w/rest.php/*"
    ],
    "nativeRestful": [
      "/api/v1/*"
    ]
  },
  "gates": [
    {
      "id": "G-API-INVENTORY",
      "mandatory": true
    },
    {
      "id": "G-COMPAT-CONTRACT",
      "mandatory": true
    },
    {
      "id": "G-NATIVE-CONTRACT",
      "mandatory": true
    },
    {
      "id": "G-STATE-PARITY",
      "mandatory": true
    },
    {
      "id": "G-SEC-PARITY",
      "mandatory": true
    },
    {
      "id": "G-UPGRADE-PARITY",
      "mandatory": true
    },
    {
      "id": "G-EXT-API",
      "mandatory": true
    },
    {
      "id": "G-DBMS-MATRIX",
      "mandatory": true
    },
    {
      "id": "G-APP-CPU-MATRIX",
      "mandatory": true
    },
    {
      "id": "G-STORAGE-MATRIX",
      "mandatory": true
    },
    {
      "id": "G-PARSER-CORPUS",
      "mandatory": true
    },
    {
      "id": "G-RELEASE-1-0",
      "mandatory": true
    },
    {
      "id": "G-RECOVERY",
      "mandatory": true
    }
  ],
  "requirements": {
    "baselineVersion": "1.46.2",
    "futureMediaWikiApiUpdatesMustBeDualSurface": true,
    "newPlatformExtensionFunctionsMustHaveNativeRest": true,
    "allCompatRoutesConformToActualBaseline": true,
    "allCoreAndExtensionDatabaseEngines": [
      "MARIADB",
      "POSTGRESQL",
      "SQL_SERVER",
      "ORACLE"
    ],
    "applicationArchitectures": [
      "arm64",
      "amd64"
    ],
    "storageBackends": [
      "LOCAL",
      "S3_COMPATIBLE"
    ],
    "thirdPartyInfrastructureRuntimeIndependent": true,
    "enwikiCertificationRequiredForProductGa": false,
    "siteMigrationApprovalRequiredForProductGa": false
  },
  "note": "이 파일은 실행된 테스트 결과가 아닌 CI 릴리스 게이트 설계 예시입니다.",
  "releaseProfile": "release_profile_1_0.json",
  "documentType": "RELEASE_GATE_SPECIFICATION",
  "parserCorpusRequirements": "../source/10_COMPATIBILITY.md",
  "separateApprovalGateIds": [
    "G-ENWIKI",
    "G-MIGRATION"
  ]
}
